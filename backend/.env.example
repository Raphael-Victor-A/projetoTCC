# Copie para .env e preencha antes de rodar

# Chave da API do Google Gemini (https://aistudio.google.com/apikey)
GEMINI_API_KEY=

# Modelo usado pelo Orquestrador de IA. Spec do TCC pede 1.5 Flash, mas o
# Google descontinuou esse modelo para chaves novas; gemini-2.5-flash e o
# sucessor direto na mesma classe (rapido/custo baixo). Pra conferir os
# modelos disponiveis pra sua key: GET
# https://generativelanguage.googleapis.com/v1beta/models?key=SUA_KEY
GEMINI_MODEL=gemini-2.5-flash

# Segredo para assinatura dos tokens JWT — gerar algo aleatorio forte em producao
JWT_SECRET_KEY=troque-este-valor-por-um-segredo-aleatorio-forte
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=120

# Connection string do banco. SQLite por padrao (zero setup).
# Para Postgres real: postgresql+psycopg2://usuario:senha@localhost:5432/tcc_db
DATABASE_URL=sqlite:///./tcc.db

# Limite de chamadas ao Gemini por usuario por minuto (protecao de custo).
# Cobre tanto a geracao de questoes (toda vez que /exercises/next e chamado)
# quanto o feedback de erro — ajuste pra cima se o aluno estiver esbarrando
# no limite so de navegar entre exercicios.
GEMINI_RATE_LIMIT_PER_MINUTE=30

# Credenciais da conta admin criada automaticamente no primeiro start.
# TROQUE a senha antes de expor a aplicacao fora da sua maquina.
ADMIN_EMAIL=admin@tccadmin.com
ADMIN_PASSWORD=admin123
