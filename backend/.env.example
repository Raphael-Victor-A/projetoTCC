# Copie para .env e preencha antes de rodar

# Chave da API do Google Gemini (https://aistudio.google.com/apikey)
# Sem ela a plataforma continua funcionando: as questoes vem do acervo
# estatico e as mini aulas caem na versao de reserva montada com a grade.
GEMINI_API_KEY=

# Modelo usado pelo Orquestrador de IA. Atencao a COTA: no free tier o
# gemini-2.5-flash permite apenas 20 requisicoes/dia, e ao estourar todo o
# conteudo de IA cai no fallback (confira em GET /health o campo
# ai_quota_blocked_for). Modelos *-flash-lite costumam ter cota bem maior.
# Para listar os modelos disponiveis para sua chave:
# https://generativelanguage.googleapis.com/v1beta/models?key=SUA_KEY
GEMINI_MODEL=gemini-3.5-flash-lite

# Temperatura do feedback pedagogico. A autoria de questoes usa 0.6 e as mini
# aulas 0.4 (fixos no codigo): variedade importa la, previsibilidade aqui.
GEMINI_TEMPERATURE=0.1

# Limite de chamadas ao Gemini por usuario por minuto (protecao de custo).
# Um questionario inteiro custa 1 chamada, entao o limite raramente e atingido
# so navegando.
GEMINI_RATE_LIMIT_PER_MINUTE=30

# Tempo maximo (segundos) de uma chamada ao Gemini antes de cair no acervo de
# reserva. Impede que uma chamada travada segure a tela do aluno.
GEMINI_TIMEOUT_SECONDS=25

# Chamadas simultaneas ao Gemini permitidas no processo inteiro.
GEMINI_MAX_CONCURRENCY=8

# Cache em memoria do conteudo gerado (questionarios e mini aulas).
AI_CACHE_TTL_SECONDS=1800
AI_CACHE_MAX_ENTRIES=512

# Quantas questoes cada questionario de reforco/pratica traz. Todas sao
# geradas em UMA unica chamada a API.
QUIZ_SIZE=5

# Quantas questoes o Questionario Diagnostico apresenta, sorteadas de um banco
# grande com equilibrio entre disciplinas e niveis.
DIAGNOSTIC_SIZE=12

# Quando true, o diagnostico mistura questoes ineditas geradas por IA ao banco
# estatico. Padrao false para que o primeiro acesso seja instantaneo.
DIAGNOSTIC_AI_AUGMENT=false

# Quantas vezes o aluno pode pedir "explicar de outro jeito" em cada mini
# aula (cada pedido e uma chamada a API). Validado no backend.
LESSON_REEXPLAIN_LIMIT=1

# Live Search: permite ao tutor consultar a busca do Google (grounding) quando
# a pergunta depende de informacao atual.
LIVE_SEARCH_ENABLED=true

# Segredo para assinatura dos tokens JWT — gerar algo aleatorio forte em producao
JWT_SECRET_KEY=troque-este-valor-por-um-segredo-aleatorio-forte
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=120

# Connection string do banco. SQLite por padrao (zero setup).
# Para Postgres real: postgresql+psycopg2://usuario:senha@localhost:5432/tcc_db
DATABASE_URL=sqlite:///./tcc.db

# Origens do frontend autorizadas (CORS), separadas por virgula.
# Em producao: CORS_ORIGINS=https://seu-frontend.onrender.com
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Credenciais da conta admin criada automaticamente no primeiro start.
# TROQUE a senha antes de expor a aplicacao fora da sua maquina.
ADMIN_EMAIL=admin@tccadmin.com
ADMIN_PASSWORD=admin123
